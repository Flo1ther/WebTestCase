SECRET_KEY=replace-with-a-local-secret
DEBUG=True
DEMO_SEED_ON_START=true
DATABASE_URL=postgresql://testflow:change-me@localhost:55433/testflow
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=testflow-local-demo
AI_TIMEOUT=15
# Project-centred AI generation receives the selected Project.ai_context and Requirement.
# Real local LLM through Ollama: set AI_PROVIDER=ollama and choose a pulled model.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:3b
# OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# Required only for a compatible external provider:
# AI_API_BASE_URL=https://api.openai.com/v1/chat/completions

PUBLIC_BASE_URL=http://localhost:5173
# GitHub Actions callback (optional). For a real remote workflow PUBLIC_API_URL
# must be a public HTTPS tunnel/domain, not localhost.
PUBLIC_API_URL=http://127.0.0.1:8000
GITHUB_WEBHOOK_SECRET=
TOTP_ENCRYPTION_KEY=generate-a-fernet-key
TURNSTILE_TEST_MODE=true
# Official Cloudflare test key: always displays an interactive challenge locally.
TURNSTILE_SITE_KEY=3x00000000000000000000FF
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
EMAIL_HOST=127.0.0.1
EMAIL_PORT=11025
# Для лабораторної реєстрація завершується активацією з одноразового листа Mailpit.
EMAIL_VERIFICATION_REQUIRED=true
# Create a Web application OAuth client in Google Cloud. See README for exact local callback URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRUSTED_PROXY_IPS=
