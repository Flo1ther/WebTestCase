FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock.txt
RUN useradd --create-home app
COPY manage.py ./
COPY config ./config
COPY apps ./apps
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/api/health/', timeout=3)" || exit 1
CMD ["sh", "-c", "python manage.py migrate --noinput && if [ \"${DEMO_SEED_ON_START:-false}\" = \"true\" ]; then python manage.py seed_demo && python manage.py seed_quality_demo; fi && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 2"]
